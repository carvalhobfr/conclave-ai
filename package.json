{
  "name": "conclave-ai",
  "version": "0.11.0",
  "description": "Graph-aware independent validator for code changes and agent claims",
  "keywords": [
    "ai",
    "agent",
    "code-review",
    "validation",
    "developer-tools",
    "cli"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/carvalhobfr/conclave-ai.git"
  },
  "bugs": {
    "url": "https://github.com/carvalhobfr/conclave-ai/issues"
  },
  "homepage": "https://github.com/carvalhobfr/conclave-ai#readme",
  "type": "module",
  "files": [
    "dist",
    "docs/assets",
    "docs/review-lineage.md",
    "docs/security.md",
    "examples/github-actions",
    "schemas",
    "scripts/install-agent-skill.mjs",
    "skills/conclave-validate",
    "README.md",
    "README.pt-BR.md",
    "CHANGELOG.md",
    "CHANGELOG.pt-BR.md",
    "ROADMAP.md",
    "LICENSE",
    "docs/product-0.9.md",
    "docs/acceptance.md",
    "docs/ci-evidence.md",
    "action.yml",
    "scripts/action-review.mjs"
  ],
  "bin": {
    "conclave": "dist/cli.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build:core": "tsc -p tsconfig.build.json",
    "build:web": "vite build",
    "build": "npm run build:core && npm run build:web",
    "clean": "node scripts/clean-dist.mjs",
    "prepack": "npm run clean && npm run build",
    "dev": "npm run build --silent && node dist/cli.js",
    "dev:web": "vite --host 127.0.0.1",
    "demo": "npm run build --silent && node dist/cli.js demo",
    "start:web": "npm run build:core --silent && node dist/web/server.js",
    "eval": "npm run dev -- eval tests/fixtures/code-rag tests/fixtures/code-rag/eval-cases.json --json",
    "eval:graph": "npm run dev -- eval-graph tests/fixtures/code-rag tests/fixtures/code-rag/eval-cases.json tests/fixtures/code-rag/graph-eval-cases.json --json",
    "eval:release": "npm run dev -- eval-graph tests/fixtures/code-rag tests/fixtures/code-rag/release-eval-cases.json --json",
    "eval:reasoning": "vitest run tests/reasoning-evaluation.test.ts --maxWorkers=1",
    "eval:skill": "vitest run tests/agent-skill.test.ts tests/mcp-server.test.ts --maxWorkers=1",
    "audit": "npm audit --omit=dev",
    "lint": "eslint .",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "test:web": "vitest run --config vitest.web.config.ts --maxWorkers=1",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc -p web/tsconfig.json --noEmit",
    "verify": "npm run typecheck && npm run lint && npm run build && npm test && npm run test:web && npm run eval && npm run eval:graph && npm run eval:release && npm run audit",
    "eval:validation": "vitest run tests/git-change-set.test.ts tests/super-validator.test.ts tests/validation-web.test.ts --maxWorkers=1",
    "eval:precision": "vitest run tests/escalation.test.ts tests/source-defects.test.ts tests/pr-summary.test.ts --maxWorkers=1"
  },
  "dependencies": {
    "ignore": "7.0.6",
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "24.10.13",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "10.8.1",
    "globals": "17.9.0",
    "jsdom": "^30.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript-eslint": "8.66.0",
    "vite": "^8.2.1",
    "vitest": "4.1.10"
  }
}
